<!DOCTYPE html>
<!-- paulirish.com/2008/conditional-stylesheets-vs-css-hacks-answer-neither/ -->
<!--[if lt IE 7]> <html class="no-js lt-ie9 lt-ie8 lt-ie7" lang="en"> <![endif]-->
<!--[if IE 7]> <html class="no-js lt-ie9 lt-ie8" lang="en"> <![endif]-->
<!--[if IE 8]> <html class="no-js lt-ie9" lang="en"> <![endif]-->
<!--[if gt IE 8]><!-->
<html lang="en">
  <!--<![endif]-->
  <head>
    <meta charset="utf-8"/>

    <!-- Set the viewport width to device width for mobile -->
    <meta name="viewport" content="width=device-width, initial-scale=1"/>

    <title>xkcd 2:
      {% if comic %}{{ comic.safe_title }}{% else %}{{ error.title }}{% endif %}</title>
    {% if comic %}
    <meta property="og:title" content="xkcd 2: {{ comic.safe_title }}"/>
    <meta property="og:description" content="{{ comic.alt|escape }}"/>
    <meta property="og:type" content="article"/>
    <meta property="og:image" content="{{ origin }}/og/{{ comic.num }}.png"/>
    <meta property="og:image:width" content="1200"/>
    <meta property="og:image:height" content="630"/>
    <meta name="twitter:card" content="summary_large_image"/>
    <meta name="twitter:title" content="xkcd 2: {{ comic.safe_title }}"/>
    <meta name="twitter:description" content="{{ comic.alt|escape }}"/>
    <meta name="twitter:image" content="{{ origin }}/og/{{ comic.num }}.png"/>
    {% else %}
    <meta name="robots" content="noindex"/>
    {% endif %}

    <link rel="stylesheet" href="https://use.typekit.net/zst8lfn.css">
    <link rel="stylesheet" href="/css/main.min.css">
    <link rel="stylesheet" href="/css/reader.css">
    <script src="https://tinylytics.app/embed/95MQi2A5EyYPDKh4sZja.js" defer></script>
  </head>
  <body class="expando-container">
    <header id="main">
      <div class="site-title has-text-centered">
        <a href="/" aria-label="xkcd 2: latest comic">xkcd<span class="emphasize">2</span></a>
      </div>
    </header>
    <main id="reader" class="expando">
      <section class="section" aria-labelledby="comic-heading">
        <div class="container">
          <div id="comic" class="columns is-centered">
            <div class="column is-three-fifths">
              {% if comic %}
              <div class="has-text-centered">
                <h1 id="comic-heading" class="title">{{ comic.safe_title|escape|typogrify|safe }}</h1>

                <a class="comic-image-link" href="{{ comic.img }}" aria-label="Open full-size comic: {{ comic.safe_title }}">
                  <img src="{{ comic.img }}" class="image" alt="{{ imageDescription }}" title="{{ comic.alt }}"/>
                  <span class="image-link-label">Open full-size comic</span>
                </a>
              </div>
              <div class="message is-centered is-primary is-bordered">
                <div class="message-body">
                  <p id="comic-title">{{ comic.alt|escape|typogrify|safe }}</p>
                </div>
              </div>
              <nav id="comic-nav" class="level is-mobile buttons" aria-label="Comic navigation">
                <div class="level-left">
                  <div class="level-item">
                    {% if previousId %}
                    <a class="button is-outlined" href="/{{ previousId }}/" title="previous comic">« Previous</a>
                    {% else %}
                    <span class="button is-outlined is-static" aria-disabled="true" title="First comic">« Previous</span>
                    {% endif %}
                  </div>
                </div>
                <div class="level-item">
                  <a class="button is-outlined" href="/random/" title="random comic">Random</a>
                </div>
                <div class="level-right">
                  <div class="level-item">
                    {% if nextId %}
                    <a class="button is-outlined"
                      href="/{{ nextId }}/" title="next comic">Next »</a>
                    {% else %}
                    <span class="button is-outlined is-static" aria-disabled="true" title="next comic">Next »</span>
                    {% endif %}
                  </div>
                </div>
              </nav>
              {% else %}
              <div class="has-text-centered">
                <h1 id="comic-heading" class="title">{{ error.title }}</h1>
                <div class="content">
                  <p>{{ error.message }}</p>
                </div>
                <nav id="recovery-nav" class="buttons is-centered" aria-label="Comic recovery">
                  {% if error.retryUrl %}
                  <a class="button is-outlined" href="{{ error.retryUrl }}">Try again</a>
                  {% endif %}
                  <a class="button is-outlined" href="/">Latest comic</a>
                  <a class="button is-outlined" href="/random/">Random comic</a>
                </nav>
              </div>
              {% endif %}
            </div>
          </div>
        </div>
      </section>
    </main>
    <footer id="footer" class="footer columns is-centered">
      <div class="column is-narrow">
        <div class="message is-link is-unbordered">
          <div class="message-body">
            <div class="content is-small has-text-centered">
              <p>xkcd 2 is a project by
                <a href="https://www.tylerbutler.com/">Tyler Butler</a>.<br/>
                <a href="/about/">Learn more about it.</a>
              </p>
              <p>xkcd is written by Randall Munroe.<br/>
                Comics are used under a
                <a href="http://creativecommons.org/licenses/by-nc/2.5/">CC BY-NC 2.5 License.</a>
              </p>
            </div>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
